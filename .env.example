# ALYO configuration. Every value has a working default; ALYO boots with no
# .env at all. Copy to .env and fill in only what you need. Never commit .env.
# All variables are read with the ALYO_ prefix, e.g. ALYO_APP_PORT=8760.

# --- Runtime -------------------------------------------------------------
# 127.0.0.1 = this PC only. Use 0.0.0.0 to reach ALYO from your phone /
# other devices on the same network (open http://<YOUR-LAN-IP>:8760, and
# allow inbound TCP 8760 in Windows Firewall).
ALYO_APP_HOST=127.0.0.1
ALYO_APP_PORT=8760
ALYO_ENVIRONMENT=development
ALYO_LOG_LEVEL=INFO
ALYO_DATABASE_URL=sqlite:///./data/alyo.db

# --- Authentication (baseline security, free for every user) -------------
ALYO_SESSION_TTL_MINUTES=720
ALYO_ALLOW_OPEN_REGISTRATION=true
ALYO_PBKDF2_ITERATIONS=310000
ALYO_LOGIN_RATE_LIMIT=5
ALYO_LOGIN_RATE_WINDOW=60
ALYO_CHAT_RATE_LIMIT=30
ALYO_CHAT_RATE_WINDOW=60

# --- Social sign-in (real OAuth 2.0 + PKCE). Empty = not configured: the UI
# shows "Integration not configured." with these exact names instead of a
# fake button. Create OAuth clients with redirect URI:
#   http://127.0.0.1:8760/api/v1/auth/oauth/google/callback      (Google)
#   http://127.0.0.1:8760/api/v1/auth/oauth/linkedin/callback    (LinkedIn)
ALYO_GOOGLE_CLIENT_ID=
ALYO_GOOGLE_CLIENT_SECRET=
ALYO_LINKEDIN_CLIENT_ID=
ALYO_LINKEDIN_CLIENT_SECRET=
# Facebook uses the official manual authorization-code flow (Graph API v26.0,
# state + server-side secret exchange; PKCE is OIDC-only on Facebook, so this
# provider relies on state + the secret — both real protections). Meta provides
# NO email-verification signal, so a Facebook identity is always treated as
# unverified and can never take over an existing password account.
# Redirect URI to register in the Facebook app: Valid OAuth Redirect URIs:
#   http://127.0.0.1:8760/api/v1/auth/oauth/facebook/callback
# You also need the app in Live/Standard mode and a Data Deletion Callback URL.
ALYO_FACEBOOK_CLIENT_ID=
ALYO_FACEBOOK_CLIENT_SECRET=
# Create an account automatically on first social login (false = link-only).
ALYO_OAUTH_AUTO_PROVISION=true
# Public origin for redirect URIs behind a reverse proxy (empty = derive).
#ALYO_PUBLIC_BASE_URL=https://assistant.example.com
# Point sign-in at any OIDC-compliant server instead of the default provider
# endpoints (Keycloak, Authentik, Azure AD, internal verification servers).
# Empty = provider default.
#ALYO_GOOGLE_AUTHORIZATION_URL=
#ALYO_GOOGLE_TOKEN_URL=
#ALYO_GOOGLE_USERINFO_URL=
#ALYO_LINKEDIN_AUTHORIZATION_URL=
#ALYO_LINKEDIN_TOKEN_URL=
#ALYO_LINKEDIN_USERINFO_URL=
#ALYO_FACEBOOK_AUTHORIZATION_URL=
#ALYO_FACEBOOK_TOKEN_URL=
#ALYO_FACEBOOK_USERINFO_URL=

# --- Brain ---------------------------------------------------------------
ALYO_WAKE_WORD=hey jarvis
ALYO_LLM_PROVIDER=local
ALYO_OPENAI_API_KEY=
ALYO_OPENAI_MODEL=gpt-4o-mini
ALYO_OPENAI_BASE_URL=https://api.openai.com/v1
ALYO_PERSONALITY_MODE=friendly

# --- Data retention (days). See docs/SECURITY.md and GET /api/v1/privacy/retention
ALYO_RETENTION_CONVERSATIONS_DAYS=90
ALYO_RETENTION_SECURITY_EVENTS_DAYS=180
ALYO_RETENTION_CRITICAL_INCIDENT_DAYS=365
ALYO_RETENTION_AUDIT_DAYS=365
ALYO_RETENTION_TEMP_DAYS=7
ALYO_RETENTION_TASK_HISTORY_DAYS=30
ALYO_RETENTION_WORKER_INTERVAL_MINUTES=60

# --- Security ------------------------------------------------------------
ALYO_AUTO_CONTAINMENT_ENABLED=true
ALYO_HIGH_SECURITY_PLAN_PRICE=699
ALYO_HIGH_SECURITY_PLAN_PERIOD=monthly
ALYO_COLLEGE_SECURITY_CONTACT=
ALYO_IT_SECURITY_CONTACT=

# --- Emergency (physical emergencies are separate from cyber incidents) ---
ALYO_EMERGENCY_REGION=IN
ALYO_EMERGENCY_NUMBER=112

# --- J.A.R.V.S LINK (physical voice device) --------------------------------
# The LINK pairs through /api/v1/devices; its voice plane is a separate
# WebSocket process on this port (run: python -m backend.voice.server).
ALYO_VOICE_HOST=0.0.0.0
ALYO_VOICE_PORT=8761
ALYO_VOICE_WS_PATH=/ws/device
ALYO_VOICE_SAMPLE_RATE=16000
ALYO_VOICE_CHANNELS=1
ALYO_VOICE_MAX_SECONDS=30
ALYO_DEVICE_PAIRING_TTL_MINUTES=10

# STT: "" = STT OFFLINE (honest failure). "whisper" = local faster-whisper
# (pip install faster-whisper). Language: "hi", "en", "kn" or empty = auto.
ALYO_STT_PROVIDER=
ALYO_STT_MODEL=base
ALYO_STT_LANGUAGE=

# TTS: "" = TTS OFFLINE. "edge" = Microsoft neural voices via edge-tts +
# miniaudio (pip install edge-tts miniaudio). Voices (default Hindi):
#   hi-IN-MadhurNeural   (Hindi, default)   en-IN-PrabhatNeural  (English IN)
#   kn-IN-GaganNeural    (Kannada)          en-US-AriaNeural     (English US)
ALYO_TTS_PROVIDER=
ALYO_TTS_VOICE=
ALYO_TTS_RATE=1.0

# VAD (energy-based; silk/optional tuning)
ALYO_VAD_THRESHOLD_DB=-35.0
ALYO_VAD_FRAME_MS=20
ALYO_VAD_MIN_SPEECH_MS=250
ALYO_VAD_SILENCE_MS=700

# --- Future integrations are gated on real credentials ----------------------
# Facebook/LinkedIn/Google above; AI providers above. Payments, notifications
# and Android push are NOT IMPLEMENTED until a real merchant/backend exists.
