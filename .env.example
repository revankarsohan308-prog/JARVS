# ALYO configuration. Every value has a working default; ALYO boots with no
# .env at all. Copy to .env and fill in only what you need. Never commit .env.
# All variables are read with the ALYO_ prefix, e.g. ALYO_APP_PORT=8760.

# --- Runtime -------------------------------------------------------------
ALYO_APP_HOST=127.0.0.1
ALYO_APP_PORT=8760
ALYO_ENVIRONMENT=development
ALYO_LOG_LEVEL=INFO
ALYO_DATABASE_URL=sqlite:///./data/alyo.db

# --- Authentication (baseline security, free for every user) -------------
ALYO_SESSION_TTL_MINUTES=720
ALYO_ALLOW_OPEN_REGISTRATION=true
ALYO_PBKDF2_ITERATIONS=310000
ALYO_LOGIN_RATE_LIMIT=5
ALYO_LOGIN_RATE_WINDOW=60
ALYO_CHAT_RATE_LIMIT=30
ALYO_CHAT_RATE_WINDOW=60

# --- Brain ---------------------------------------------------------------
ALYO_WAKE_WORD=hey jarvis
ALYO_LLM_PROVIDER=local
ALYO_OPENAI_API_KEY=
ALYO_OPENAI_MODEL=gpt-4o-mini
ALYO_OPENAI_BASE_URL=https://api.openai.com/v1
ALYO_PERSONALITY_MODE=friendly

# --- Data retention (days). See docs/SECURITY.md and GET /api/v1/privacy/retention
ALYO_RETENTION_CONVERSATIONS_DAYS=90
ALYO_RETENTION_SECURITY_EVENTS_DAYS=180
ALYO_RETENTION_CRITICAL_INCIDENT_DAYS=365
ALYO_RETENTION_AUDIT_DAYS=365
ALYO_RETENTION_TEMP_DAYS=7
ALYO_RETENTION_TASK_HISTORY_DAYS=30
ALYO_RETENTION_WORKER_INTERVAL_MINUTES=60

# --- Security ------------------------------------------------------------
ALYO_AUTO_CONTAINMENT_ENABLED=true
ALYO_HIGH_SECURITY_PLAN_PRICE=699
ALYO_HIGH_SECURITY_PLAN_PERIOD=monthly
ALYO_COLLEGE_SECURITY_CONTACT=
ALYO_IT_SECURITY_CONTACT=

# --- Emergency (physical emergencies are separate from cyber incidents) ---
ALYO_EMERGENCY_REGION=IN
ALYO_EMERGENCY_NUMBER=112
